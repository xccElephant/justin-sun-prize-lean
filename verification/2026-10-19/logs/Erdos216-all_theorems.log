AUDIT|Erdos216.horton_top_strictly_above_bottom_secant|[propext, Classical.choice, Quot.sound]
TYPE|Erdos216.horton_top_strictly_above_bottom_secant|∀ {k c : ℕ},
  2 ^ (k + 1) + 1 ≤ c →
    ∀ {m₁ m₂ m₃ : ℕ},
      m₁ < m₂ →
        2 * m₂ < 2 ^ (k + 1) →
          2 * m₃ + 1 < 2 ^ (k + 1) →
            have x₁ := 2 * ↑m₁;
            have y₁ := ↑(Erdos216.hortonY c (k + 1) (2 * m₁));
            have x₂ := 2 * ↑m₂;
            have y₂ := ↑(Erdos216.hortonY c (k + 1) (2 * m₂));
            have x₃ := 2 * ↑m₃ + 1;
            have y₃ := ↑(Erdos216.hortonY c (k + 1) (2 * m₃ + 1));
            (y₂ - y₁) * (x₃ - x₁) < (y₃ - y₁) * (x₂ - x₁)
