AUDIT|Erdos348.step_exists._proof_1_24|[propext, Classical.choice, Quot.sound]
TYPE|Erdos348.step_exists._proof_1_24|∀ {B : ℕ → ℕ} {T : ℕ} {H : Finset ℕ} (hH : H.Nonempty) (K' J₀ J₁ L₁ K₁ K₂ j N : ℕ)
  (E : Finset ℕ) (hE : E.Nonempty),
  B j + (2 * H.max' hH + max T (max (Erdos348.prefixSum B (max J₀ J₁)) (Erdos348.prefixSum B L₁)) + 1) ≤
      Erdos348.prefixSum B j →
    max T (H.max' hH) < B (j - 1) →
      Erdos348.prefixSum B L₁ ≤ max T (max (Erdos348.prefixSum B (max J₀ J₁)) (Erdos348.prefixSum B L₁)) →
        B j = B (N - 1) →
          B (j - 1) < B j →
            ∀ l < j,
              ∀ (E' : Finset ℕ) (hst' : Erdos348.IsState B H l j E'),
                max T (B (max K' (H.max' hH))) < B l →
                  ∀ (j' N' : ℕ),
                    (B l = B (j - 1) →
                        Erdos348.statePotential B (H.max' hH) j' N' E' = (H.max' hH + 1) * E'.card + E'.min' ⋯) →
                      (B l ≠ B (j - 1) →
                          Erdos348.statePotential B (H.max' hH) j' N' E' = (H.max' hH + 1) * (E'.card + 1)) →
                        B l = B (j - 1) →
                          Erdos348.prefixSum B j = Erdos348.prefixSum B l + (j - l) * B (j - 1) →
                            E.min' hE ≤ H.max' hH →
                              Erdos348.prefixSum B j - B j - E.min' hE ≤ Erdos348.prefixSum B l →
                                B j - B l ≤ Erdos348.prefixSum B l - (Erdos348.prefixSum B j - B j - E.min' hE) →
                                  ¬j - l = 1 → 2 ≤ j - l → 2 * B (j - 1) ≤ (j - l) * B (j - 1) → False
