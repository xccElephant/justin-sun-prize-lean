                      (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                        (congrArg (Or (y = u))
                          (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                            (congrArg (Or (y = v)) Erdos23.erdos_23.variants.n1._simp_1_5)))))
                    hy))
              fun h =>
              Or.casesOn h
                (fun h =>
                  Eq.ndrec (motive := fun v => G.Adj u v → G.Adj v w → y = u ∨ y = v ∨ y = w → G.Adj x y)
                    (fun h1 h2 hy =>
                      Or.casesOn hy
                        (fun h =>
                          Eq.ndrec (motive := fun u => G.Adj u w → G.Adj u x → G.Adj x y)
                            (fun h3 h1 => SimpleGraph.Adj.symm h1) h h3 h1)
                        fun h =>
