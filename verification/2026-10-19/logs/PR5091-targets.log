Erdos23.erdos_23.variants.n1_tight : ∃ G,
  G.CliqueFree 3 ∧ ∀ H ≤ G, H.IsBipartite → 1 ≤ (G.edgeFinset \ H.edgeFinset).card
theorem Erdos23.erdos_23.variants.n1_tight : ∃ G,
  G.CliqueFree 3 ∧ ∀ H ≤ G, H.IsBipartite → 1 ≤ (G.edgeFinset \ H.edgeFinset).card :=
Exists.intro (SimpleGraph.cycleGraph 5)
  ⟨id Erdos23.erdos_23.variants.n1_tight._proof_1_1, fun H hHG hH =>
    Decidable.byContradiction fun hcon =>
      have h0 := Finset.card_eq_zero.mp (Nat.lt_one_iff.mp (not_le.mp hcon));
      have hsub := Finset.sdiff_eq_empty_iff_subset.mp h0;
      have hGH :=
        SimpleGraph.edgeSet_subset_edgeSet.mp fun x he =>
          Eq.mp
            (forall_congr fun ⦃x⦄ =>
              implies_congr Erdos23.erdos_23.variants.n1_tight._simp_1_1 Erdos23.erdos_23.variants.n1_tight._simp_1_1)
            (Eq.mp (congrArg (fun _a => _a) (propext Finset.subset_iff)) hsub) he;
      Eq.ndrec (motive := fun H =>
        H ≤ SimpleGraph.cycleGraph 5 →
          H.IsBipartite →
            ¬1 ≤ ((SimpleGraph.cycleGraph 5).edgeFinset \ H.edgeFinset).card →
              (SimpleGraph.cycleGraph 5).edgeFinset \ H.edgeFinset = ∅ →
                (∀ ⦃x : Sym2 (Fin 5)⦄, x ∈ (SimpleGraph.cycleGraph 5).edgeSet → x ∈ H.edgeSet) →
                  SimpleGraph.cycleGraph 5 ≤ H → False)
        (fun hHG hH hcon h0 hsub hGH =>
          have h2 := SimpleGraph.Colorable.chromaticNumber_le hH;
          absurd
            (Eq.mp
              (congrArg (fun _a => _a ≤ ↑2)
                (SimpleGraph.chromaticNumber_cycleGraph_of_odd 5
                  (Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 2))
                    (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 5)) (Eq.refl true))
                  (of_decide_eq_true (id (Eq.refl true)))))
              h2)
            (of_decide_eq_true (id (Eq.refl true))))
        (Eq.symm (le_antisymm hHG hGH)) hHG hH hcon h0
        (Eq.mp
          (forall_congr fun ⦃x⦄ =>
            implies_congr Erdos23.erdos_23.variants.n1_tight._simp_1_1 Erdos23.erdos_23.variants.n1_tight._simp_1_1)
          (Eq.mp (congrArg (fun _a => _a) (propext Finset.subset_iff)) hsub))
