                                            Quot.mk (Sym2.Rel (Fin 5)) (x, y) ∉ (G ⊓ Erdos23.bipFromSet✝ S).edgeSet →
                                          G.Adj x y →
                                            (x ∈ S ↔ y ∈ S) → z ∈ Quot.mk (Sym2.Rel (Fin 5)) (x, y) → ¬z = v ∧ z ∉ S)
                                        (fun he hxy h_same hz =>
