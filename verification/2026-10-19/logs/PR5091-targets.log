                      have h_same :=
                        have h1 := not_ne_iff.mp fun hdiff => he.right ⟨hxy, hdiff⟩;
                        eq_iff_iff.mp h1;
                      Eq.mpr (id (congrArg (fun _a => _a) (propext Finset.mem_filter)))
