                                    fun h =>
                                    Eq.ndrec (motive := fun y =>
                                      Quot.mk (Sym2.Rel (Fin 5)) (x, y) ∈ G.edgeSet ∧
                                          Quot.mk (Sym2.Rel (Fin 5)) (x, y) ∉ (G ⊓ Erdos23.bipFromSet✝ S).edgeSet →
