                          (fun h =>
                            Eq.ndrec (motive := fun ⦃x⦄ => x ≠ y → G.Adj u x → G.Adj x w → G.Adj x y)
                              (fun hxy h1 h2 => False.elim (hxy rfl)) h hxy h1 h2)
                          fun h =>
                          Eq.ndrec (motive := fun w => G.Adj u w → G.Adj x w → G.Adj x y) (fun h3 h2 => h2) h h3 h2)
                    h h1 h2
                    (Eq.mp
                      (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_3
                        (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                          (congrArg (Or (y = u))
                            (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                              (congrArg (Or (y = v)) Erdos23.erdos_23.variants.n1._simp_1_5)))))
                      hy))
                fun h =>
                Eq.ndrec (motive := fun w => G.Adj v w → G.Adj u w → y = u ∨ y = v ∨ y = w → G.Adj x y)
                  (fun h2 h3 hy =>
                    Or.casesOn hy
                      (fun h =>
                        Eq.ndrec (motive := fun u => G.Adj u v → G.Adj u x → G.Adj x y)
                          (fun h1 h3 => SimpleGraph.Adj.symm h3) h h1 h3)
                      fun h =>
                      Or.casesOn h
                        (fun h =>
                          Eq.ndrec (motive := fun v => G.Adj u v → G.Adj v x → G.Adj x y)
                            (fun h1 h2 => SimpleGraph.Adj.symm h2) h h1 h2)
                        fun h =>
                        Eq.ndrec (motive := fun ⦃x⦄ => x ≠ y → G.Adj v x → G.Adj u x → G.Adj x y)
                          (fun hxy h2 h3 => False.elim (hxy rfl)) h hxy h2 h3)
                  h h2 h3
                  (Eq.mp
                    (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_3
                      (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                        (congrArg (Or (y = u))
                          (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                            (congrArg (Or (y = v)) Erdos23.erdos_23.variants.n1._simp_1_5)))))
