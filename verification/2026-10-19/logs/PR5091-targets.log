                                            Eq.ndrec (motive := fun v =>
                                              2 ≤ (G.neighborFinset v).card →
                                                let S := G.neighborFinset v;
                                                S = G.neighborFinset v →
                                                  v ∉ S →
                                                    (insert v S).card ≤ 5 →
                                                      (insert v S)ᶜ.card ≤ 2 →
                                                        Quot.mk (Sym2.Rel (Fin 5)) (z, y) ∈ G.edgeSet ∧
                                                            Quot.mk (Sym2.Rel (Fin 5)) (z, y) ∉
                                                              (G ⊓ Erdos23.bipFromSet✝ S).edgeSet →
