Erdos23.erdos_23.variants.n1 : ∀ (G : SimpleGraph (Fin 5)),
  G.CliqueFree 3 → ∃ H ≤ G, H.IsBipartite ∧ (G.edgeFinset \ H.edgeFinset).card ≤ 1
theorem Erdos23.erdos_23.variants.n1 : ∀ (G : SimpleGraph (Fin 5)),
  G.CliqueFree 3 → ∃ H ≤ G, H.IsBipartite ∧ (G.edgeFinset \ H.edgeFinset).card ≤ 1 :=
fun G hcf =>
  have h_not_tri := fun u v w h =>
    match h with
    | ⟨h1, ⟨h2, h3⟩⟩ =>
      hcf {u, v, w}
        {
          isClique := fun ⦃x⦄ hx ⦃y⦄ hy hxy =>
            Or.casesOn
              (Eq.mp
                (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_3
                  (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                    (congrArg (Or (x = u))
                      (Eq.trans Erdos23.erdos_23.variants.n1._simp_1_4
                        (congrArg (Or (x = v)) Erdos23.erdos_23.variants.n1._simp_1_5)))))
                hx)
              (fun h =>
                Eq.ndrec (motive := fun u => G.Adj u v → G.Adj u w → y = u ∨ y = v ∨ y = w → G.Adj x y)
                  (fun h1 h3 hy =>
                    Or.casesOn hy
                      (fun h =>
                        Eq.ndrec (motive := fun ⦃x⦄ => x ≠ y → G.Adj x v → G.Adj x w → G.Adj x y)
