@Erdos602.erdos_602.variants.disjoint : ∀ {α : Type u_1} {I : Type u_2} (A : I → Set α),
  (∀ (i : I), (A i).Infinite) → (∀ (i j : I), i ≠ j → Disjoint (A i) (A j)) → Erdos602.HasPropertyB I A
theorem Erdos602.erdos_602.variants.disjoint.{u_1, u_2} : ∀ {α : Type u_1} {I : Type u_2} (A : I → Set α),
  (∀ (i : I), (A i).Infinite) → (∀ (i j : I), i ≠ j → Disjoint (A i) (A j)) → Erdos602.HasPropertyB I A :=
fun {α} {I} A hInfinite hDisjoint =>
  have ha_b := fun i =>
    Exists.casesOn (Set.Infinite.nonempty (hInfinite i)) fun a ha =>
      have hA2 := Set.Infinite.nonempty (Set.Infinite.sdiff (hInfinite i) (Set.finite_singleton a));
      Exists.casesOn hA2 fun b h =>
        And.casesOn h fun hbA hba =>
          Exists.intro a
            (Exists.intro b
              ⟨ha,
                ⟨hbA, fun h => Eq.mp (congrArg Not Erdos602.erdos_602.variants.disjoint._simp_1_1) hba (Eq.symm h)⟩⟩);
  (fun a_fn x =>
      (fun b_fn x =>
          have key := fun i j haj =>
            if hij : i = j then
              Eq.ndrec (motive := fun j => a_fn i = b_fn j → False)
                (fun haj => (fun i => ((fun i => (x i).right) i).right) i haj) hij haj
            else
              have hdisj := hDisjoint i j hij;
              have hbj := (fun i => ((fun i => (x i).right) i).left) j;
              Eq.mp (congrArg (fun _a => _a) (propext Set.disjoint_left)) hdisj ((fun i => (x i).left) i)
                (Eq.mp (congrArg (fun _a => _a ∈ A j) (Eq.symm haj)) hbj);
          let f := fun n => if ∃ i, n = b_fn i then 1 else 0;
          Exists.intro f fun i hMono =>
            have hfa :=
              id
                (Eq.mpr (id (congrArg (fun _a => _a = 0) (if_neg fun a => Exists.casesOn a fun j hj => key i j hj)))
                  (Eq.refl 0));
            have hfb := id (Eq.mpr (id (congrArg (fun _a => _a = 1) (if_pos (Exists.intro i rfl)))) (Eq.refl 1));
            have hne :=
              hMono (a_fn i) ((fun i => (x i).left) i) (b_fn i) ((fun i => ((fun i => (x i).right) i).left) i);
            absurd (Eq.mp (congrArg (fun _a => 0 = _a) hfb) (Eq.mp (congrArg (fun _a => _a = f (b_fn i)) hfa) hne))
              (of_decide_eq_true (id (Eq.refl true))))
        (fun i => Classical.choose (x i)) fun i => Classical.choose_spec (x i))
    (fun i => Classical.choose (ha_b i)) fun i => Classical.choose_spec (ha_b i)
