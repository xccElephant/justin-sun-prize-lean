                          this ≍ List.Mem.head as → ¬Erdos602.IsMonochromatic (fun n => if n = y then 1 else 0) (A i))
                      (fun this tail_eq =>
                        Eq.ndrec (motive := fun as =>
                          this ≍ List.Mem.head as →
                            ¬Erdos602.IsMonochromatic (fun n => if n = y then 1 else 0)
                                (A ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_refl 2)⟩)))
