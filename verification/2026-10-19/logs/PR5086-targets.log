                                  (eq_self 0));
                            have hfy :=
                              of_eq_true
                                (Eq.trans (congrFun' (congrArg Eq (ite_cond_eq_true 1 0 (eq_self y))) 1) (eq_self 1));
                            have this := hMono x hxI.left y hyI.left;
                            absurd
                              (Eq.mp (congrArg (fun _a => 0 = _a) hfy)
                                (Eq.mp (congrArg (fun _a => _a = (fun n => if n = y then 1 else 0) y) hfx) this))
                              (of_decide_eq_true (id (Eq.refl true))))
