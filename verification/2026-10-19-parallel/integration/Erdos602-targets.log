Erdos602.paired_core_original_hypotheses :
  (∀ (i : Option ℕ), (Erdos602.pairedFamily i).Countable ∧ (Erdos602.pairedFamily i).Infinite) ∧
    (∀ (i j : Option ℕ), i ≠ j → (Erdos602.pairedFamily i ∩ Erdos602.pairedFamily j).Finite) ∧
      ∀ (i j : Option ℕ), i ≠ j → (Erdos602.pairedFamily i ∩ Erdos602.pairedFamily j).ncard ≠ 1
'Erdos602.paired_core_original_hypotheses' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos602.paired_core_hasPropertyB : Erdos602.HasPropertyB (Option ℕ) Erdos602.pairedFamily
'Erdos602.paired_core_hasPropertyB' depends on axioms: [propext]
Erdos602.paired_core_no_fresh_pair :
  (∀ (i : ℕ), Erdos602.pairedWitnesses i ⊆ Erdos602.pairedSatellite i) ∧
    (∀ (i j : ℕ), i ≠ j → Disjoint (Erdos602.pairedWitnesses i) (Erdos602.pairedWitnesses j)) ∧
      Erdos602.pairedCore \ ⋃ i, Erdos602.pairedWitnesses i = ∅
'Erdos602.paired_core_no_fresh_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos602.splitting_condition_not_preserved_by_pointwise_limit :
  (∀ (n : ℕ), ¬Erdos602.IsMonochromatic (fun x => if x ≤ n then 0 else 1) Set.univ) ∧
    (∀ (x : ℕ), ∃ N, ∀ n ≥ N, (if x ≤ n then 0 else 1) = 0) ∧ Erdos602.IsMonochromatic (fun x => 0) Set.univ
'Erdos602.splitting_condition_not_preserved_by_pointwise_limit' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Erdos602.independent_chain_union_obstruction :
  have S := fun n => {x | x.1 = 0 ∧ x.2.1 < n};
  Monotone S ∧ (∀ (n : ℕ) (i : Option ℕ), ¬Erdos602.pairedFamily i ⊆ S n) ∧ Erdos602.pairedFamily none ⊆ ⋃ n, S n
'Erdos602.independent_chain_union_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
