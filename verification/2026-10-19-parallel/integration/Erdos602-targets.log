Erdos602.countably_infinite_members_uncountable_union.{u_1} {β : Type u_1} [Uncountable β] :
  have A := fun i => Set.range fun n => (i, n);
  (∀ (i : β), (A i).Countable ∧ (A i).Infinite) ∧ (∀ (i j : β), i ≠ j → Disjoint (A i) (A j)) ∧ ¬(⋃ i, A i).Countable
'Erdos602.countably_infinite_members_uncountable_union' depends on axioms: [propext, Classical.choice, Quot.sound]
